<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hexagon.springmvc.mapper.AccountMapper">
	
	<!-- 스프링 시큐리티가 아이디를 이용하여 조회할 수 있도록 제공 -->
	<select id="selectById" parameterType="String" resultType="Account">
		select account_id, emp_id, login_id, password, enabled, created_at, last_login_at
		from account 
		where login_id=#{loginId}
	</select>


</mapper>